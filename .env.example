# Copy to `.env` and fill in the values. All three are server-only: never
# prefix them with NEXT_PUBLIC_. On Vercel set them in Project Settings ->
# Environment Variables.

# Supabase project (shared with remindeer-backoffice), read as `anon`.
# SUPABASE_URL is also needed at build time: the host allowed for the hero
# image is derived from it in next.config.ts.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Shared secret of the content revalidation webhook. Pick a long random value
# (e.g. `openssl rand -hex 32`). While it is unset POST /api/revalidate answers
# 401 to everyone and edited content only appears after the hourly refresh.
REVALIDATE_SECRET=

# --- Revalidation webhook (manual setup, done once in the Supabase dashboard) ---
#
# Database -> Webhooks -> Create a new hook
#   Table:        public.page_contents
#   Events:       INSERT, UPDATE, DELETE
#   Type:         HTTP Request
#   Method:       POST
#   URL:          https://<production domain>/api/revalidate
#   HTTP header:  x-revalidate-secret: <same value as REVALIDATE_SECRET>
#                 Content-Type: application/json
#
# The body is the default webhook payload; the endpoint reads `record.slug`,
# falling back to `old_record.slug`, and expires the cache tag
# `page-content:<slug>`. Responses: 401 wrong or missing secret, 400 no slug,
# 200 revalidated.
